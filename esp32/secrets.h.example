// secrets.h.example - plantilla de credenciales del ESP32
//
// COMO USARLO
//   1. Copia este archivo como "secrets.h" en ESTA MISMA carpeta:
//          cp secrets.h.example secrets.h
//   2. Pon tus valores reales en secrets.h.
//
// secrets.h esta listado en .gitignore, asi que NUNCA se sube a GitHub.
// Este archivo (.example) si se sube, pero solo con valores de relleno.
//
// Si el sketch no compila porque no encuentra secrets.h, es justamente
// esto lo que falta: copia la plantilla.

#pragma once

// Contrasena de la red WiFi que crea el ESP32 (minimo 8 caracteres).
#define AP_PASSWORD_SECRET "pon-aqui-la-contrasena-del-ap"

// Debe coincidir con la variable de entorno DEVICE_KEY del servidor Node.js.
// En la laptop:  DEVICE_KEY=<misma-clave> npm start
#define DEVICE_KEY_SECRET "pon-aqui-la-device-key"
