# Dependencias (se vuelven a instalar con "npm install")
node_modules/

# ===== CREDENCIALES: NUNCA SUBIR A GITHUB =====

# Contraseña de MySQL
server/db-config.json

# Credenciales del ESP32 (AP_PASSWORD y DEVICE_KEY).
