secrets.h
**/secrets.h
!secrets.h.example
!**/secrets.h.example

# Variables de entorno
.env
.env.*
!.env.example

# Llaves y certificados
*.pem
*.key
*.p12
*.pfx
id_rsa*
*_rsa
*.ppk

# Base de datos SQLite de la versión anterior
*.db
*.db-shm
*.db-wal

# Archivos del sistema y del editor
.DS_Store
Thumbs.db
.vscode/
